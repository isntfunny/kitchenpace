generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// =====================================// ENUMS
// =====================================
// Roles are stored as strings: "user", "admin", "moderator", "banned"

enum TrophyTier {
  NONE
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MealStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Meal plan, shopping list and pantry (KUC-79 / KUC-98)
// Base unit of a stored quantity; other units are converted via IngredientUnit/Unit
enum BaseUnit {
  G
  ML
  PIECE
}

enum ShoppingItemStatus {
  OPEN
  PURCHASED
  DORMANT
}

enum ShoppingSourceKind {
  RECIPE
  MEAL_PLAN
  MANUAL
  SUGGESTION
  BRING
}

enum ShoppingHistoryEvent {
  ADDED
  PURCHASED
}

enum ShoppingOrigin {
  KOCHTAKT
  BRING
}

enum BringSyncStatus {
  IDLE
  OK
  ERROR
  AUTH_FAILED
}

enum PantrySource {
  PURCHASE
  BRING
  COOKING
  MANUAL
}

// AVAILABLE = still there ("offen" in the tickets); openedAt tracks the opening separately
enum PantryStatus {
  AVAILABLE
  USED_UP
  DISCARDED
}

enum MealPlanReminderKind {
  COOK_START
  WEEKLY_PLAN
}

enum MealPlanReminderStatus {
  SCHEDULED
  SENT
  SKIPPED
  CANCELLED
}

enum RecipeClusterRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  NEW_FOLLOWER
  RECIPE_LIKE
  RECIPE_COMMENT
  RECIPE_RATING
  RECIPE_COOKED
  RECIPE_PUBLISHED
  WEEKLY_PLAN_REMINDER
  SYSTEM
}

enum ActivityType {
  RECIPE_CREATED
  RECIPE_COOKED
  RECIPE_RATED
  RECIPE_COMMENTED
  RECIPE_FAVORITED
  RECIPE_UNFAVORITED
  USER_FOLLOWED
  USER_REGISTERED
  USER_ACTIVATED
  MEAL_PLAN_CREATED
  SHOPPING_LIST_CREATED
  STREAM_STARTED
  COLLECTION_CREATED
  COLLECTION_FAVORITED
}

enum CollectionTemplate {
  SIDEBAR
  GRID_BELOW
  HERO_PICKS
  INLINE
}

enum CollectionRecipeRole {
  HERO
  SIDEBAR
  INLINE
  GRID
}

enum PaletteColor {
  orange
  gold
  emerald
  purple
  blue
  pink
}

enum FilterSetType {
  TIME_SEASON
  FOOD_PERIOD
}

enum DateResolveType {
  FIXED
  RELATIVE_EASTER
  RELATIVE_ADVENT
}

enum ModerationStatus {
  APPROVED
  PENDING
  REJECTED
  AUTO_APPROVED
}

// Ingredient shelf life (KUC-94)
enum StorageType {
  FRIDGE
  PANTRY
  FREEZER
}

enum ShelfLifeSource {
  AI
  MANUAL
  DEFAULT
}

enum ShelfLifeConfidence {
  HIGH
  MEDIUM
  LOW
}

enum PackUnit {
  G
  ML
  PIECE
  BUNCH
}

// =====================================// AUTH MODELS (Better Auth)
// =====================================
model Account {
  id                    String     @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Session {
  id             String    @id @default(cuid())
  token          String    @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime  @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================// USER & PROFILE
// =====================================
model User {
  apiKeys Apikey[]
  apiMutations ApiMutation[]
  apiImports ApiImport[]
  bringConnection BringConnection?
  bringTransfers BringTransfer[]
  id                        String                    @id @default(cuid())
  name                      String?
  email                     String                    @unique
  emailVerified             Boolean                   @default(false)
  image                     String?
  role                      String                    @default("user")
  banned                    Boolean                   @default(false)
  banReason                 String?
  banExpires                DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  //                        Relations
  accounts                  Account[]
  sessions                  Session[]
  passkeys                  Passkey[]
  profile                   Profile?
  recipes                   Recipe[]
  comments                  Comment[]
  ratings                   UserRating[]
  favorites                 Favorite[]
  followedBy                Follow[]                 @relation("FollowedBy")
  following                 Follow[]                 @relation("Following")
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  mealPlans                 MealPlan[]
  mealPlanEntries           MealPlanRecipe[]
  mealPlanTemplates         MealPlanTemplate[]
  mealPlanReminders         MealPlanReminder[]
  shoppingList              ShoppingList?
  shoppingHistory           ShoppingHistory[]
  shoppingSuggestionSnoozes ShoppingSuggestionSnooze[]
  bringSyncConflicts        BringSyncConflict[]
  pantryItems               PantryItem[]
  approvedClusterRuns       RecipeClusterRun[]
  activities                ActivityLog[]
  viewHistory               UserViewHistory[]
  cookHistory               UserCookHistory[]
  pinnedFavorites           PinnedFavorite[]
  cookImages                CookImage[]
  importRuns                ImportRun[]
  moderationQueueAsAuthor   ModerationQueue[]        @relation("ModerationQueueAuthor")
  moderationQueueAsReviewer ModerationQueue[]        @relation("ModerationQueueReviewer")
  moderationLogs            ModerationLog[]          @relation("ModerationLogActor")
  reports                   Report[]                 @relation("ReportSubmitter")
  tutorialCompletions       UserTutorialCompletion[]
  earnedTrophies            UserTrophy[]
  trophyPoints              Int                       @default(0)
  twitchStream              TwitchStream?
  plannedStreams             PlannedStream[]
  collections               Collection[]
  collectionFavorites       CollectionFavorite[]
}

model UserTutorialCompletion {
  id          String    @id @default(cuid())
  userId      String
  tutorialKey String
  completedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialKey])
  @@index([tutorialKey])
}

model Profile {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  nickname                   String    @db.VarChar(40)
  slug                       String    @unique @db.VarChar(60)
  teaser                     String?
  photoKey                   String?
  bio                        String?
  followerCount              Int       @default(0)
  followingCount             Int       @default(0)
  recipeCount                Int       @default(0)
  ratingsPublic              Boolean   @default(true)
  followsPublic              Boolean   @default(true)
  favoritesPublic            Boolean   @default(true)
  cookedPublic               Boolean   @default(true)
  trophiesPublic             Boolean   @default(true)
  showTrophyOnAvatar         Boolean   @default(true)
  showInActivity             Boolean   @default(true)
  notifyOnAnonymous          Boolean   @default(false)
  notifyOnNewFollower        Boolean   @default(true)
  notifyOnRecipeLike         Boolean   @default(true)
  notifyOnRecipeComment      Boolean   @default(true)
  notifyOnRecipeRating       Boolean   @default(true)
  notifyOnRecipeCooked       Boolean   @default(true)
  notifyOnRecipePublished    Boolean   @default(true)
  notifyOnWeeklyPlanReminder Boolean   @default(true)
  notifyOnSystemMessages     Boolean   @default(true)
  notifyOnNewsletter         Boolean   @default(true)
  notifyOnStreamStarted      Boolean   @default(true)
  // Push "Zeit anzufangen" before a planned slot (KUC-109)
  notifyOnCookStart          Boolean   @default(true)

  // Meal plan settings (KUC-102). Days are ISO weekdays: 1 = Monday … 7 = Sunday.
  householdSize              Int?      // null = not asked yet; the UI asks on first planning
  weekStartDay               Int       @default(1)
  shoppingDay                Int?
  timezone                   String    @default("Europe/Berlin") @db.VarChar(64)
  mealPlanShowTime           Boolean   @default(true)
  mealPlanShowServings       Boolean   @default(false)
  mealPlanShowCalories       Boolean   @default(true)
  // Slot configuration, see src/lib/meal-plan/slots.ts (null = defaults)
  mealPlanSlots              Json?
  // Quiet hours for push reminders, local HH:mm (null = none)
  quietHoursStart            String?   @db.VarChar(5)
  quietHoursEnd              String?   @db.VarChar(5)

  // Twitch integration (twitchId lives in account.accountId where providerId='twitch')
  twitchUsername              String?   @db.VarChar(60)
  twitchConnectedAt          DateTime?

  // User taste profile (weighted average of recipe embeddings from interactions)
  tasteEmbedding             Float[]
  tasteUpdatedAt             DateTime?

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nickname])
}

// =====================================// RECIPE & INGREDIENTS
// =====================================
model Recipe {
  apiImport ApiImport?
  id                                                                         String              @id @default(cuid())
  title                                                                      String
  slug                                                                       String              @unique
  description                                                                String?
  imageKey                                                                   String?
  blurhash                                                                   String?
  imageWidth                                                                 Int?
  imageHeight                                                                Int?
  servings                                                                   Int                 @default(4)
  prepTime                                                                   Int                 @default(0)
  cookTime                                                                   Int                 @default(0)
  totalTime                                                                  Int                 @default(0)
  // Nutrition (auto-calculated from ingredients on save)
  caloriesPerServing                                                         Int?
  proteinPerServing                                                          Float?
  fatPerServing                                                              Float?
  carbsPerServing                                                            Float?
  fiberPerServing                                                            Float?
  nutritionCompleteness                                                      Float?
  difficulty                                                                 Difficulty          @default(MEDIUM)
  status                                                                     RecipeStatus        @default(DRAFT)
  publishedAt                                                                DateTime?
  rating                                                                     Float               @default(0)
  ratingCount                                                                Int                 @default(0)
  viewCount                                                                  Int                 @default(0)
  cookCount                                                                  Int                 @default(0)
  isTrending                                                                 Boolean             @default(false)

  // Flow data as JSON
  flowNodes                                                                  Json?
  flowEdges                                                                  Json?

  // AI-assisted flow generation (prepared for future use)
  rawRecipeText String?  // Classic text recipe, sent to AI to generate flow

  // Import source (YouTube/TikTok/website URL for embeds)
  sourceUrl     String?  @db.VarChar(2048)

  // Content moderation
  moderationStatus                                                           ModerationStatus    @default(AUTO_APPROVED)
  moderationNote                                                             String?
  aiModerationScore                                                          Float?

  authorId                                                                   String
  createdAt                                                                  DateTime            @default(now())
  updatedAt                                                                  DateTime            @updatedAt

  //                                                                         Relations
  author                                                                     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categories                                                                 RecipeCategory[]
  recipeIngredients                                                          RecipeIngredient[]
  comments                                                                   Comment[]
  ratings                                                                    UserRating[]
  favorites                                                                  Favorite[]
  tags                                                                       RecipeTag[]
  mealPlanRecipes                                                            MealPlanRecipe[]
  mealPlanTemplateEntries                                                    MealPlanTemplateEntry[]
  shoppingItemSources                                                        ShoppingItemSource[]
  shoppingHistory                                                            ShoppingHistory[]
  clusterMemberships                                                         RecipeClusterMember[]
  userViewHistory                                                            UserViewHistory[]
  cookHistory                                                                UserCookHistory[]
  pinnedFavorites                                                            PinnedFavorite[]
  cookImages                                                                 CookImage[]
  importRuns                                                                 ImportRun[]
  stepImages                                                                 RecipeStepImage[]
  embedding                                                                  RecipeEmbedding?
  plannedStreams                                                              PlannedStream[]
  collectionRecipes                                                           CollectionRecipe[]

  @@index([authorId])
  @@index([difficulty])
  @@index([createdAt])
  @@index([rating])
  @@index([status])
  @@index([isTrending])
  @@index([moderationStatus])
}

model RecipeEmbedding {
  recipeId  String   @id
  embedding Float[]
  model     String   @db.VarChar(60)
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model TwitchStream {
  id                String    @id @default(cuid())
  userId            String    @unique
  isLive            Boolean   @default(false)

  // Live state (from EventSub)
  twitchStreamId    String?
  startedAt         DateTime?
  endedAt           DateTime?
  title             String?
  viewerCount       Int?

  // EventSub tracking
  eventSubOnlineId  String?   @unique
  eventSubOfflineId String?   @unique
  eventSubSecret    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isLive])
}

model PlannedStream {
  id                String    @id @default(cuid())
  userId            String
  recipeId          String
  plannedAt         DateTime?
  plannedTimezone   String?   @db.VarChar(60)
  twitchSegmentId   String?   @db.VarChar(120)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe            Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
}

// =====================================// RECIPE STEP IMAGES
// =====================================
model RecipeStepImage {
  id        String    @id @default(cuid())
  recipeId  String
  stepId    String
  photoKey  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepId])
  @@index([recipeId])
  @@index([photoKey])
}

// =====================================// RECIPE IMPORTER RUNS (audit + cost tracking)
// =====================================
enum ImportRunStatus {
  SUCCESS  // AI analyzed + recipe saved
  FALLBACK // AI failed/unavailable, used regex fallback parser
  FAILED   // Hard failure (scraping error, unrecoverable)
}

model ImportRun {
  id                                                                           String           @id @default(cuid())
  userId                                                                       String

  //                                                                           Source
  sourceUrl        String?         // null = pasted text (AI dialog in editor)
  sourceType                                                                   String           @default("url") // "url" | "text"
  markdownLength   Int?            // scraped content size in chars

  //                                                                           Result
  status                                                                       ImportRunStatus
  errorType        String?         // maps to ErrorType enum from importer
  errorMessage                                                                 String?
  recipeId         String?         // linked recipe if successfully saved

  // AI usage (matches OpenAI usage object fields)
  model             String?         // e.g. "gpt-6.2-sol"
  inputTokens       Int?            // prompt_tokens
  cachedInputTokens Int?            // prompt_tokens_details.cached_tokens
  outputTokens      Int?            // completion_tokens
  // Cost: input $2.00/1M, cached $0.10/1M, output $10.00/1M
  estimatedCostUsd                                                             Float?

  // Raw OpenAI completion object for debugging & auditing
  rawApiResponse                                                               Json?

  createdAt                                                                    DateTime         @default(now())

  user                                                                         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe                                                                       Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId,                                                             createdAt])
  @@index([status])
  @@index([createdAt])
}

// =====================================// INGREDIENTS (Master List + Recipe-specific)
// =====================================
model Ingredient {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  pluralName      String?
  aliases         String[]            @default([])
  needsReview     Boolean             @default(false)
  createdAt       DateTime            @default(now())

  // Clean display name (KUC-114); `name` stays unchanged.
  normalizedName       String?
  // true = edited in admin, the AI never overwrites it
  normalizedNameManual Boolean @default(false)

  // Shelf life of the raw ingredient (KUC-94). Without shelfLifeSource the
  // ingredient is not assessed yet; once set, a missing IngredientStorageLife
  // row means this storage type is not possible.
  defaultStorage      StorageType?
  // Days after opening at defaultStorage; 0 = use the same day
  openedShelfLifeDays Int?
  openSensitive       Boolean              @default(false)
  packSize            Float?
  packUnit            PackUnit?
  shelfLifeSource     ShelfLifeSource?
  shelfLifeConfidence ShelfLifeConfidence?

  // IconOven icon name without prefix, e.g. "carrot" (KUC-125)
  icon String? @db.VarChar(64)

  // Swiss Food DB reference
  swissFoodId              Int?    @unique

  // Nutrition per 100g (from Swiss Food Composition Database V 7.0)
  energyKj                 Float?
  energyKcal               Float?
  fat                      Float?
  saturatedFat             Float?
  monoUnsaturatedFat       Float?
  polyUnsaturatedFat       Float?
  linoleicAcid             Float?
  alphaLinolenicAcid       Float?
  epa                      Float?
  dha                      Float?
  cholesterol              Float?
  carbs                    Float?
  sugar                    Float?
  starch                   Float?
  fiber                    Float?
  protein                  Float?
  salt                     Float?
  alcohol                  Float?
  water                    Float?
  sodium                   Float?
  vitaminA_RE              Float?  @map("vitamin_a_re")
  vitaminA_RAE             Float?  @map("vitamin_a_rae")
  retinol                  Float?
  betaCaroteneActivity     Float?  @map("beta_carotene_activity")
  betaCarotene             Float?  @map("beta_carotene")
  vitaminB1                Float?  @map("vitamin_b1")
  vitaminB2                Float?  @map("vitamin_b2")
  vitaminB6                Float?  @map("vitamin_b6")
  vitaminB12               Float?  @map("vitamin_b12")
  niacin                   Float?
  folate                   Float?
  pantothenicAcid          Float?  @map("pantothenic_acid")
  vitaminC                 Float?  @map("vitamin_c")
  vitaminD                 Float?  @map("vitamin_d")
  vitaminE                 Float?  @map("vitamin_e")
  potassium                Float?
  chloride                 Float?
  calcium                  Float?
  magnesium                Float?
  phosphorus               Float?
  iron                     Float?
  iodine                   Float?
  zinc                     Float?
  selenium                 Float?

  // Relations
  categories      IngredientCategory[]
  ingredientUnits IngredientUnit[]
  recipes         RecipeIngredient[]
  shoppingItems   ShoppingItem[]
  shoppingHistory ShoppingHistory[]
  pantryItems     PantryItem[]
  filterSets      FilterSetIngredient[]
  storageLives    IngredientStorageLife[]

  @@index([name])
  @@index([normalizedName])
  @@index([aliases], type: Gin)
}

model IngredientStorageLife {
  id           String      @id @default(cuid())
  ingredientId String
  storage      StorageType
  days         Int // > 0, enforced by a CHECK constraint

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, storage])
}

model IngredientCategory {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  sortOrder   Int                  @default(0)
  // IconOven icon name without prefix; subcategories inherit (KUC-125)
  icon        String?              @db.VarChar(64)
  parentId    String?
  parent      IngredientCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    IngredientCategory[] @relation("CategoryTree")
  ingredients Ingredient[]

  @@index([parentId])
}

model Unit {
  id                String             @id @default(cuid())
  shortName         String             @unique
  longName          String             @unique
  gramsDefault      Float?
  ingredients       IngredientUnit[]
  recipeIngredients RecipeIngredient[]
}

model IngredientUnit {
  ingredientId String
  unitId       String
  grams        Float?

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([ingredientId, unitId])
  @@index([ingredientId])
  @@index([unitId])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  sourceId     String?    // Stable editor/import alias across autosaves
  recipeId     String
  ingredientId String
  unitId       String
  amount       String     // Recipe-specific: "400", "1/2", "2-3"
  notes        String?    // "finely chopped", "room temperature", etc.
  position     Int        @default(0)
  isOptional   Boolean    @default(false)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id])

  // The same catalogue ingredient can occur with different amounts/notes.
  // Flow mentions reference this row's id, not the catalogue ingredientId.
  @@index([recipeId, ingredientId])
  @@unique([recipeId, sourceId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([unitId])
}

// =====================================// CATEGORIES & TAGS
// =====================================
model Category {
  id                                                                            String            @id @default(cuid())
  name                                                                          String            @unique
  slug                                                                          String            @unique
  description                                                                   String?
  color                                                                         PaletteColor      @default(orange)
  icon          String?  // Lucide icon name (e.g. "utensils", "cake", "salad")
  coverImageKey String?  // S3 key for hero/cover image
  sortOrder                                                                     Int               @default(0)
  createdAt                                                                     DateTime          @default(now())

  recipes                                                                       RecipeCategory[]
  filterSets                                                                    FilterSetCategory[]
  collectionCategories                                                          CollectionCategory[]
}

model RecipeCategory {
  recipeId   String
  categoryId String
  position   Int       @default(0) // For ordering categories

  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
  @@index([recipeId])
  @@index([categoryId])
}

model Tag {
  id         String           @id @default(cuid())
  name       String           @unique
  slug       String           @unique
  recipes        RecipeTag[]
  filterSets     FilterSetTag[]
  collectionTags CollectionTag[]
  createdAt      DateTime         @default(now())
}

model RecipeTag {
  recipeId  String
  tagId     String
  createdAt DateTime  @default(now())

  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model Comment {
  id               String            @id @default(cuid())
  content          String
  imageKey         String?
  recipeId         String
  authorId         String
  moderationStatus ModerationStatus  @default(AUTO_APPROVED)
  isHidden         Boolean           @default(false)
  moderationNote   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  recipe           Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([authorId])
  @@index([moderationStatus])
}

// =====================================// SOCIAL: RATINGS & FAVORITES
// =====================================
model UserRating {
  id                        String    @id @default(cuid())
  recipeId                  String
  userId                    String
  rating    Int      // 1-5
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  recipe                    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId,       userId])
  @@index([recipeId])
  @@index([userId])
}

model Favorite {
  id        String    @id @default(cuid())
  recipeId  String
  userId    String
  createdAt DateTime  @default(now())

  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([userId])
  @@index([recipeId, createdAt])
}

// =====================================// SOCIAL: FOLLOW SYSTEM
// =====================================
model Follow {
  id          String    @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime  @default(now())

  follower    User     @relation("FollowedBy", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// =====================================// NOTIFICATIONS
// =====================================
model Notification {
  id                                                                        String            @id @default(cuid())
  userId                                                                    String
  type                                                                      NotificationType
  title                                                                     String
  message                                                                   String
  data      Json?            // Additional data: { recipeId, userId, etc. }
  read                                                                      Boolean           @default(false)
  createdAt                                                                 DateTime          @default(now())

  user                                                                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId,                                                          read])
}

model PushSubscription {
  id                                                String    @id @default(cuid())
  userId                                            String
  endpoint                                          String    @unique
  keys                                              Json
  label     String?  // e.g. device or browser name
  createdAt                                         DateTime  @default(now())
  updatedAt                                         DateTime  @updatedAt

  user                                              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================// MEAL PLANNING (KUC-98)
// =====================================
model MealPlan {
  // Optional week record (KUC-98): entries hang on dates, not on this row.
  // Holds week-only settings and the revocable share link (KUC-110).
  id                    String            @id @default(cuid())
  userId                String
  startDate             DateTime          @db.Date
  name                  String?           @db.VarChar(80)
  // Week-only slot configuration, same shape as Profile.mealPlanSlots (null = user default)
  slotOverride          Json?
  shareToken            String?           @unique @db.VarChar(64)
  shareCreatedAt        DateTime?
  shareRevokedAt        DateTime?
  // Notes and custom slot names are moderated before sharing (KUC-110)
  shareModerationStatus ModerationStatus?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startDate])
}

// One planned dish (KUC-98). Several dishes per slot via position.
model MealPlanRecipe {
  id             String     @id @default(cuid())
  userId         String
  recipeId       String
  date           DateTime   @db.Date
  // Exactly one of mealType / customMealType is set (CHECK constraint)
  mealType       MealType?
  // Key of a custom slot from the slot configuration
  customMealType String?    @db.VarChar(40)
  position       Int        @default(0)
  // Local time HH:mm in Profile.timezone; null = slot default
  time           String?    @db.VarChar(5)
  servings       Int
  status         MealStatus @default(PLANNED)
  // Fixed by the user, never moved by suggestions (KUC-96)
  pinned         Boolean    @default(false)
  notes          String?    @db.VarChar(500)
  // Confirmed "Gekocht" (KUC-103); cookHistoryId prevents double counting
  cookedAt       DateTime?
  cookHistoryId  String?    @unique
  // Usage booked into the pantry (confirmed or assumed after the day passed, KUC-103/107)
  pantryBookedAt DateTime?
  // "Für 2 Mahlzeiten kochen": this entry is the leftover of another one (KUC-101)
  leftoverOfId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe         Recipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookHistory    UserCookHistory?     @relation(fields: [cookHistoryId], references: [id], onDelete: SetNull)
  leftoverOf     MealPlanRecipe?      @relation("MealPlanLeftover", fields: [leftoverOfId], references: [id], onDelete: SetNull)
  leftovers      MealPlanRecipe[]     @relation("MealPlanLeftover")
  shoppingSources ShoppingItemSource[]
  pantryItems    PantryItem[]

  @@index([userId, date])
  @@index([recipeId])
  @@index([leftoverOfId])
}

// Named week template (KUC-101)
model MealPlanTemplate {
  id        String                  @id @default(cuid())
  userId    String
  name      String                  @db.VarChar(80)
  entries   MealPlanTemplateEntry[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MealPlanTemplateEntry {
  id             String    @id @default(cuid())
  templateId     String
  recipeId       String
  // 0 = first day of the week the template is applied to
  dayOffset      Int
  mealType       MealType?
  customMealType String?   @db.VarChar(40)
  position       Int       @default(0)
  time           String?   @db.VarChar(5)
  servings       Int
  notes          String?   @db.VarChar(500)

  template MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipe   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([recipeId])
}

// Reminder bookkeeping (KUC-109): one row per user, kind, day and slot.
// fingerprint = hash of the slot's entries and time; a mismatch means the job is stale.
model MealPlanReminder {
  id           String                 @id @default(cuid())
  userId       String
  kind         MealPlanReminderKind
  date         DateTime               @db.Date
  // MealType name or custom slot key; "" for the weekly reminder
  slotKey      String                 @default("") @db.VarChar(40)
  scheduledFor DateTime
  jobId        String?                @db.VarChar(200)
  fingerprint  String                 @db.VarChar(64)
  status       MealPlanReminderStatus @default(SCHEDULED)
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, date, slotKey])
  @@index([status, scheduledFor])
}

// =====================================// SHOPPING LISTS
// =====================================
// One continuous list per user (Bring! principle, KUC-104)
model ShoppingList {
  id        String         @id @default(cuid())
  userId    String         @unique
  items     ShoppingItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Each ingredient / free-text name exactly once per list.
// itemKey = "i:<ingredientId>" or "t:<normalized name>" (see src/lib/shopping/item-key.ts)
model ShoppingItem {
  id              String             @id @default(cuid())
  shoppingListId  String
  ingredientId    String?
  itemKey         String             @db.VarChar(220)
  name            String             @db.VarChar(200)
  status          ShoppingItemStatus @default(OPEN)
  // Current amount: quantity in baseUnit, shown in displayUnit; quantityText holds
  // what could not be converted safely ("1 Bund"). All three may be empty.
  quantity        Float?
  baseUnit        BaseUnit?
  displayUnit     String?            @db.VarChar(20)
  quantityText    String?            @db.VarChar(200)
  note            String?            @db.VarChar(500)
  position        Int                @default(0)
  statusChangedAt DateTime           @default(now())
  // Bring! sync per item (KUC-106)
  bringName       String?            @db.VarChar(200)
  bringSpec       String?            @db.VarChar(500)
  // Hash of name/spec/status at the last sync; tells which side changed since
  bringSyncHash   String?            @db.VarChar(64)
  bringSyncedAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  shoppingList ShoppingList         @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?          @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  sources      ShoppingItemSource[]
  history      ShoppingHistory[]
  conflicts    BringSyncConflict[]

  @@unique([shoppingListId, itemKey])
  @@unique([shoppingListId, ingredientId])
  @@index([shoppingListId, status])
  @@index([ingredientId])
}

// Where an item's amount comes from ("Di: Alfredo · 200 ml")
model ShoppingItemSource {
  id               String             @id @default(cuid())
  shoppingItemId   String
  kind             ShoppingSourceKind
  recipeId         String?
  mealPlanRecipeId String?
  // Original statement from the recipe, unconverted
  originalAmount   String?            @db.VarChar(50)
  originalUnit     String?            @db.VarChar(20)
  // Converted share of the item's amount (null if not convertible)
  quantity         Float?
  baseUnit         BaseUnit?
  servings         Int?
  createdAt        DateTime           @default(now())

  shoppingItem  ShoppingItem    @relation(fields: [shoppingItemId], references: [id], onDelete: Cascade)
  recipe        Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  mealPlanEntry MealPlanRecipe? @relation(fields: [mealPlanRecipeId], references: [id], onDelete: SetNull)

  @@unique([shoppingItemId, mealPlanRecipeId])
  @@index([shoppingItemId])
  @@index([recipeId])
  @@index([mealPlanRecipeId])
}

// Purchase/add history per user and item (KUC-104); feeds pantry, rhythm (KUC-124), "zuletzt gekauft"
model ShoppingHistory {
  id             String               @id @default(cuid())
  userId         String
  ingredientId   String?
  itemKey        String               @db.VarChar(220)
  name           String               @db.VarChar(200)
  event          ShoppingHistoryEvent
  origin         ShoppingOrigin       @default(KOCHTAKT)
  occurredAt     DateTime             @default(now())
  quantity       Float?
  baseUnit       BaseUnit?
  quantityText   String?              @db.VarChar(200)
  // For which recipe it was added (if any)
  recipeId       String?
  shoppingItemId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe       Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  shoppingItem ShoppingItem? @relation(fields: [shoppingItemId], references: [id], onDelete: SetNull)
  pantryItems  PantryItem[]

  @@index([userId, itemKey, occurredAt])
  @@index([userId, event, occurredAt])
  @@index([ingredientId])
}

// "Nicht jetzt" on rhythm suggestions (KUC-124)
model ShoppingSuggestionSnooze {
  userId       String
  itemKey      String   @db.VarChar(220)
  snoozedUntil DateTime
  // Repeated dismissals damp the item
  dismissCount Int      @default(1)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemKey])
}

// Logged Bring! sync conflicts (KUC-106: checking off wins, otherwise newest change)
model BringSyncConflict {
  id             String   @id @default(cuid())
  userId         String
  shoppingItemId String?
  field          String   @db.VarChar(40)
  localValue     String?
  remoteValue    String?
  resolution     String   @db.VarChar(40)
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoppingItem ShoppingItem? @relation(fields: [shoppingItemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// =====================================// PANTRY (KUC-107)
// =====================================
model PantryItem {
  id                      String       @id @default(cuid())
  userId                  String
  ingredientId            String?
  name                    String       @db.VarChar(200)
  // Remaining amount; approximate = shown with "~"
  quantity                Float?
  baseUnit                BaseUnit?
  quantityText            String?      @db.VarChar(200)
  approximate             Boolean      @default(false)
  source                  PantrySource
  status                  PantryStatus @default(AVAILABLE)
  purchasedAt             DateTime?
  openedAt                DateTime?
  expiresAt               DateTime?
  statusChangedAt         DateTime     @default(now())
  // Leftover suggestion declined for this item (KUC-108)
  leftoverHintDismissedAt DateTime?
  shoppingHistoryId       String?
  // Last plan entry that used this item
  mealPlanRecipeId        String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient      Ingredient?      @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  shoppingHistory ShoppingHistory? @relation(fields: [shoppingHistoryId], references: [id], onDelete: SetNull)
  mealPlanEntry   MealPlanRecipe?  @relation(fields: [mealPlanRecipeId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([userId, ingredientId])
  @@index([ingredientId])
}

// =====================================// ACTIVITY & VIEW HISTORY
// =====================================
model ActivityLog {
  id         String        @id @default(cuid())
  userId     String
  type       ActivityType
  targetId   String?
  targetType String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserViewHistory {
  id       String    @id @default(cuid())
  userId   String
  recipeId String
  viewedAt DateTime  @default(now())
  pinned   Boolean   @default(false)
  source   String?   // e.g. "collection:cuid123", "category:pasta", "search"

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
  @@index([userId, viewedAt])
  @@index([recipeId, viewedAt])
}

model UserCookHistory {
  id                                         String    @id @default(cuid())
  userId                                     String
  recipeId                                   String
  cookedAt                                   DateTime  @default(now())
  servings                                   Int?
  notes                                      String?
  imageKey  String?  // S3 key for the image
  mealPlanEntry                              MealPlanRecipe?

  user                                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe                                     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([userId,                           cookedAt])
  @@index([recipeId,                         cookedAt])
}

// =====================================// COOK IMAGES (User-submitted photos)
// =====================================
model CookImage {
  id               String            @id @default(cuid())
  recipeId         String
  userId           String
  imageKey         String
  blurhash         String?
  caption          String?
  moderationStatus ModerationStatus  @default(AUTO_APPROVED)
  isHidden         Boolean           @default(false)
  createdAt        DateTime          @default(now())

  recipe           Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([userId])
  @@index([createdAt])
  @@index([moderationStatus])
}

// =====================================// PINNED FAVORITES (KUC-5)
// =====================================
model PinnedFavorite {
  id                                       String    @id @default(cuid())
  userId                                   String
  recipeId                                 String
  position  Int      // 0, 1, or 2 (max 3)
  createdAt                                DateTime  @default(now())

  user                                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe                                   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId,                        position])
  @@unique([userId,                        recipeId])
  @@index([userId])
}

// =====================================// CONTENT MODERATION
// =====================================
model ModerationQueue {
  id                                                                                 String            @id @default(cuid())
  contentType    String           // "recipe" | "comment" | "profile" | "cook_image"
  contentId      String           // FK to the relevant record
  authorId       String           // User who submitted the content
  author                                                                             User             @relation("ModerationQueueAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // AI moderation results
  aiScore        Float            // 0.0–1.0 highest category score
  aiFlags        Json             // { hate: 0.01, sexual: 0.82, ... }
  aiRawResponse  Json             // full OpenAI moderation API response

  // Human review
  status                                                                             ModerationStatus  @default(PENDING)
  reviewedBy     String?          // moderator/admin userId
  reviewer                                                                           User?            @relation("ModerationQueueReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt                                                                         DateTime?
  reviewNote     String?          // internal note from reviewer

  // Content snapshot (so mod can see what was submitted even if edited)
  contentSnapshot Json            // { title?, description?, imageUrl?, text? }

  createdAt                                                                          DateTime          @default(now())
  updatedAt                                                                          DateTime          @updatedAt

  @@index([contentType,                                                              contentId])
  @@index([status,                                                                   createdAt])
  @@index([authorId])
}

model ModerationLog {
  id                                                                                                             String    @id @default(cuid())
  actorId      String   // who took the action (admin/mod)
  actor                                                                                                          User     @relation("ModerationLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action       String   // "approve" | "reject" | "ban_user" | "unban_user" | "hide_content" | "restore_content"
  contentType  String?  // "recipe" | "comment" | "user" | etc.
  contentId    String?  // target content ID
  reason       String?  // human-provided reason
  metadata     Json?    // extra context
  createdAt                                                                                                      DateTime  @default(now())

  @@index([actorId])
  @@index([contentId])
}

model Report {
  id                                                                            String    @id @default(cuid())
  reporterId                                                                    String
  reporter                                                                      User     @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)
  contentType String   // "recipe" | "comment" | "user"
  contentId                                                                     String
  reason      String   // "spam" | "nsfw" | "hate" | "misinformation" | "other"
  description String?  // optional free text from reporter
  resolved                                                                      Boolean   @default(false)
  resolvedBy                                                                    String?
  createdAt                                                                     DateTime  @default(now())

  @@unique([reporterId, contentType, contentId])
  @@index([contentType,                                                         contentId])
  @@index([resolved])
}

// =====================================// CURATED COLLECTIONS
// =====================================
model Collection {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  description      String?
  coverImageKey    String?
  template         CollectionTemplate  @default(INLINE)
  blocks           Json?
  published        Boolean             @default(false)
  viewCount        Int                 @default(0)

  // Content moderation
  moderationStatus ModerationStatus    @default(PENDING)
  moderationNote   String?
  aiModerationScore Float?

  authorId         String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  recipes          CollectionRecipe[]
  tags             CollectionTag[]
  categories       CollectionCategory[]
  favorites        CollectionFavorite[]
  views            CollectionView[]

  @@index([authorId])
  @@index([slug])
  @@index([published, moderationStatus])
  @@index([createdAt])
  @@index([viewCount])
}

model CollectionRecipe {
  id           String               @id @default(cuid())
  collectionId String
  recipeId     String
  position     Int                  @default(0)
  role         CollectionRecipeRole @default(INLINE)

  collection   Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe       Recipe               @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, recipeId])
  @@index([recipeId])
}

model CollectionFavorite {
  id           String     @id @default(cuid())
  collectionId String
  userId       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, userId])
  @@index([userId])
}

model CollectionView {
  id           String     @id @default(cuid())
  collectionId String
  userId       String?
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([collectionId])
}

model CollectionTag {
  collectionId String
  tagId        String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectionId, tagId])
  @@index([tagId])
}

model CollectionCategory {
  collectionId String
  categoryId   String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
  @@index([categoryId])
}

// =====================================// SITE SETTINGS
// =====================================
model SiteSettings {
  id        String    @id @default(cuid())
  key       String    @unique
  value     Json?
  updatedAt DateTime  @updatedAt
  updatedBy String?
}

// =====================================// JOB RUNS (BullMQ History)
// =====================================
model JobRun {
  id                                                String     @id @default(cuid())
  queueName                                         String
  jobName                                           String
  jobId        String?   // BullMQ job ID
  status                                            JobStatus  @default(PENDING)
  payload      Json?     // Job input data
  result       Json?     // Job output/result
  errorMessage String?   // Error message if failed
  attempts                                          Int        @default(0)
  startedAt                                         DateTime?
  completedAt                                       DateTime?
  createdAt                                         DateTime   @default(now())

  @@index([queueName,                               createdAt])
  @@index([status,                                  createdAt])
  @@index([jobId])
}

// =====================================// TROPHIES / ACHIEVEMENTS
// =====================================
model Trophy {
  id                                                             String        @id // slug: "finished-tutorial" or "recipe-creator:bronze"
  groupSlug                                                      String
  tier                                                           TrophyTier    @default(NONE)
  category     String       // "ONBOARDING", "COOKING", "SOCIAL"
  name                                                           String
  description                                                    String
  icon         String       // Lucide icon name
  points                                                         Int           @default(0)
  sortOrder                                                      Int           @default(0)
  userTrophies                                                   UserTrophy[]
  createdAt                                                      DateTime      @default(now())

  @@unique([groupSlug,                                           tier])
}

model UserTrophy {
  id       String    @id @default(cuid())
  userId   String
  trophyId String
  earnedAt DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophy   Trophy   @relation(fields: [trophyId], references: [id])

  @@unique([userId, trophyId])
  @@index([userId])
}

// ── Fits-Now Filter Sets ────────────────────────────────────────────────────

model FilterSet {
  id              String           @id @default(cuid())
  type            FilterSetType

  // TIME_SEASON fields (null for FOOD_PERIOD)
  timeSlot        String?          @db.VarChar(20)
  season          String?          @db.VarChar(20)

  // FOOD_PERIOD fields (null for TIME_SEASON)
  slug            String?          @unique @db.VarChar(60)
  label           String?          @db.VarChar(120)
  description     String?
  override        Boolean          @default(false)
  resolveType     DateResolveType?
  startMonth      Int?
  startDay        Int?
  endMonth        Int?
  endDay          Int?
  startOffsetDays Int?
  endOffsetDays   Int?
  leadDays        Int              @default(0)
  trailDays       Int              @default(0)

  // Shared
  maxTotalTime    Int?
  displayLabel    String?          @db.VarChar(200)
  sortOrder       Int              @default(0)

  tags            FilterSetTag[]
  categories      FilterSetCategory[]
  ingredients     FilterSetIngredient[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([type, timeSlot, season])
  @@index([type])
}

model FilterSetTag {
  filterSetId String
  tagId       String
  filterSet   FilterSet @relation(fields: [filterSetId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([filterSetId, tagId])
  @@index([tagId])
}

model FilterSetCategory {
  filterSetId String
  categoryId  String
  filterSet   FilterSet @relation(fields: [filterSetId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([filterSetId, categoryId])
  @@index([categoryId])
}

model FilterSetIngredient {
  filterSetId  String
  ingredientId String
  filterSet    FilterSet  @relation(fields: [filterSetId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([filterSetId, ingredientId])
  @@index([ingredientId])
}

// Better Auth API-key plugin. Keys are hashed by the plugin; never store plaintext.
model Apikey {
  id                  String   @id
  configId            String   @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String   @unique
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean  @default(true)
  rateLimitEnabled    Boolean  @default(true)
  rateLimitTimeWindow  Int?
  rateLimitMax        Int?
  requestCount        Int      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  permissions         String?
  metadata            String?
  user                User     @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  @@index([configId])
  @@index([referenceId])
}

model ApiMutation {
  id          String   @id @default(cuid())
  userId      String
  operation   String
  token       String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operation, token])
}

model ApiImport {
  id             String   @id @default(cuid())
  userId         String
  keyId          String
  idempotencyKey String
  requestHash    String
  input          Json
  status         String   @default("queued")
  recipeId       String?  @unique
  errorCode      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deadline       DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe         Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, deadline])
}

// Bring remains the source of truth; these records only store access and operation receipts.
model BringConnection {
  userId String @id
  credentials String
  defaultListUuid String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Two-way sync with the KochTakt list (KUC-106)
  syncEnabled    Boolean         @default(false)
  syncListUuid   String?
  syncStatus     BringSyncStatus @default(IDLE)
  lastSyncAt     DateTime?
  lastSyncError  String?
  syncErrorCount Int             @default(0)
  // Remote snapshot of the last successful sync, base for the three-way diff
  syncSnapshot   Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([syncEnabled, lastSyncAt])
}

model BringTransfer {
  userId String
  operationId String
  requestHash String
  status String @default("PENDING")
  result Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, operationId])
  @@index([createdAt])
}

// =====================================// RECIPE THEME CLUSTERS (KUC-111)
// =====================================
model RecipeClusterRun {
  id           String                 @id @default(cuid())
  k            Int
  seed         Int
  // Embedding model of the clustered vectors (RecipeEmbedding.model)
  model        String                 @db.VarChar(60)
  status       RecipeClusterRunStatus @default(RUNNING)
  recipeCount  Int                    @default(0)
  error        String?
  // Quality check before clusters become visible
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime               @default(now())
  finishedAt   DateTime?

  approvedBy User?           @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  clusters   RecipeCluster[]

  @@index([status, createdAt])
}

model RecipeCluster {
  id          String                @id @default(cuid())
  runId       String
  // Stable across runs (matched by centroid similarity)
  key         String                @db.VarChar(64)
  label       String                @db.VarChar(120)
  // Same type as RecipeEmbedding.embedding
  centroid    Float[]
  size        Int
  tagIds      String[]              @default([])
  categoryIds String[]              @default([])
  // Further derived search filters
  filters     Json?
  active      Boolean               @default(false)
  createdAt   DateTime              @default(now())

  run     RecipeClusterRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  members RecipeClusterMember[]

  @@unique([runId, key])
  @@index([key])
  @@index([active])
}

model RecipeClusterMember {
  clusterId  String
  recipeId   String
  similarity Float

  cluster RecipeCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  recipe  Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([clusterId, recipeId])
  @@index([recipeId])
}
